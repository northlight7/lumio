DOMAIN=lumio.example.com
APP_ORIGIN=https://lumio.example.com
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=55439
POSTGRES_DB=lumio
POSTGRES_USER=lumio_app
POSTGRES_PASSWORD_FILE=../.internal/secrets/app_db_password
DEEPSEEK_API_KEY_FILE=../.internal/secrets/deepseek_key
ALLOW_SCRIPTED_AI=false
AI_DAILY_USER_LIMIT=40
AI_DAILY_GLOBAL_LIMIT=1000
MIGRATION_POSTGRES_USER=lumio
MIGRATION_POSTGRES_PASSWORD_FILE=../.internal/secrets/db_password
PROVISION_APP_ROLE=true
APP_DB_PASSWORD_FILE=../.internal/secrets/app_db_password
GUEST_SESSIONS_PER_HOUR=120
AUTH_REQUESTS_PER_15_MINUTES=60
AI_GLOBAL_CONCURRENCY=8
AI_GENERATION_AUTHOR_TIMEOUT_MS=45000
AI_GENERATION_REVIEW_TIMEOUT_MS=90000
AI_GENERATION_REPAIR_ATTEMPTS=1
AI_GENERATION_REVIEW_STREAMING=true
